{
  "name": "shelt",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A minimal Herdr and shell web terminal with clipboard image paste",
  "scripts": {
    "build": "bun run src/build.ts",
    "start": "bun run build && $HOME/.cargo/bin/cargo run -- foreground",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile": "bun run build && bun run src/compile.ts",
    "check:linux-musl": "scripts/check-linux-musl.sh release/shelt-linux-x86_64-musl && cd release && sha256sum --check shelt-linux-x86_64-musl.sha256",
    "rust:test": "$HOME/.cargo/bin/cargo test",
    "rust:check": "$HOME/.cargo/bin/cargo check"
  },
  "dependencies": {
    "@vercel/beautiful-mermaid": "0.1.5",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "katex": "0.18.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "6.0.3"
  }
}
